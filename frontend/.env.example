# ==============================================================================
# Autonomous Business Finance Platform - Frontend Environment Variables
# ==============================================================================
# Backend API Base URL
# Keep same-origin requests enabled so Vite forwards /api to the NestJS backend.
VITE_API_BASE_URL=/api

# Override only when NestJS is listening on another host or port.
VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# Force local simulated finance data without making finance API requests.
VITE_USE_SIMULATED_DATA=false

# Application Title
VITE_APP_TITLE=Autonomous Business Finance Platform
