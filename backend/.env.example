# Copy to backend/.env and replace CHANGE_ME with a private local database password.
PORT=3000
NODE_ENV=development
FINANCE_DATA_MODE=database
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/autonomous_finance_dev?schema=public

# Configure separate random keys of at least 32 characters.
# Viewer keys allow read-only access and analysis; admin keys also ingest data records.
FINANCE_VIEWER_API_KEY=
FINANCE_ADMIN_API_KEY=
