# ==============================================================================
# Autonomous Business Finance Platform - Backend Environment Variables
# ==============================================================================
# Server Port
PORT=3000

# Application Environment (development | staging | production)
NODE_ENV=development

# Application CORS Origins (comma-separated if multiple)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=[schema]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autonomous_finance_dev?schema=public

# Optional Database Connection Pooling & SSL configuration
# DATABASE_SSL=false
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10
