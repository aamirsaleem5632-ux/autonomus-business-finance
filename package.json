{
  "name": "autonomous-business-finance",
  "version": "0.1.0",
  "description": "Industrial-Grade Autonomous Business Finance Platform",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm --prefix backend run start:dev",
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "lint": "npm --prefix backend run lint && npm --prefix frontend run lint",
    "lint:backend": "npm --prefix backend run lint",
    "lint:frontend": "npm --prefix frontend run lint",
    "format": "npm --prefix backend run format && npm --prefix frontend run format",
    "test": "npm --prefix backend run test",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:validate": "npm --prefix backend run prisma:validate",
    "prisma:status": "npm --prefix backend run prisma:status",
    "prisma:migrate": "npm --prefix backend run prisma:migrate",
    "prisma:studio": "npm --prefix backend run prisma:studio"
  },
  "keywords": [
    "autonomous-finance",
    "business-finance",
    "nestjs",
    "react",
    "prisma",
    "postgresql",
    "enterprise"
  ],
  "author": "",
  "license": "UNLICENSED"
}
